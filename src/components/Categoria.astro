---
const {
    nombre,
    imagen,
    destino
} = Astro.props;
---

<article class="tarjeta-categoria">

    <div class="imagen-categoria">

        <img
            src={imagen}
            alt={nombre}
        />

    </div>


    <div class="categoria-contenido">

        <h3>
            {nombre}
        </h3>

        <button
            type="button"
            class="boton-categoria"
            data-seccion={destino}
        >
            Ver productos →
        </button>

    </div>

</article>