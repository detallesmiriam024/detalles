<script>

    // =========================
    // SECCIONES
    // =========================

    const secciones =
        document.querySelectorAll(".seccion-pagina");


    // =========================
    // ELEMENTOS CON DATA-SECCION
    // =========================

    const enlaces =
        document.querySelectorAll("[data-seccion]");


    // =========================
    // MOSTRAR UNA SECCIÓN
    // =========================

    function mostrarSeccion(nombre: string) {

        // Ocultar todas las secciones

        secciones.forEach(function(seccion) {

            seccion.classList.remove("activa");

        });


        // Buscar la sección que queremos mostrar

        const seccionMostrar =
            document.getElementById(nombre);


        // Mostrarla

        if (seccionMostrar) {

            seccionMostrar.classList.add("activa");

        }

    }


    // =========================
    // BOTONES Y ENLACES
    // =========================

    enlaces.forEach(function(enlace) {

    const elemento = enlace as HTMLElement;

    elemento.addEventListener("click", function() {

        const seccion =
            elemento.dataset.seccion;

        if (seccion) {

            mostrarSeccion(seccion);

        }

    });

});
</script>