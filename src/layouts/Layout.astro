---
const { title = "Detalles" } = Astro.props;
---

<!doctype html>

<html lang="es">

<head>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

</head>


<body>

    <!-- =========================
         HEADER
    ========================== -->

    <header class="cabecera">

        <div class="contenedor menu">

            <!-- LOGO -->

            <a
                href="#"
                class="logo"
                id="boton-inicio"
            >

                <img
                    src="/img/logo.png"
                    alt="Detalles"
                />

            </a>


            <!-- MENÚ -->

            <nav class="navegacion">

                <button
                    type="button"
                    class="enlace-menu"
                    data-seccion="inicio"
                >
                    Inicio
                </button>


                <button
                    type="button"
                    class="enlace-menu"
                    data-seccion="contacto"
                >
                    Contacto
                </button>

            </nav>

        </div>

    </header>


    <!-- =========================
         CONTENIDO
    ========================== -->

    <slot />


    <!-- =========================
         FOOTER
    ========================== -->

    <footer class="pie">

        <div class="contenedor">

            <p>
                © 2026 Detalles · Hecho con amor
            </p>

        </div>

    </footer>

</body>

</html>